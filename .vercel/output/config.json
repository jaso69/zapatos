{
	"version": 3,
	"routes": [
		{
			"handle": "filesystem"
		},
		{
			"src": "^/_astro/(.*)$",
			"headers": {
				"cache-control": "public, max-age=31536000, immutable"
			},
			"continue": true
		},
		{
			"src": "^/_server-islands/([^/]+?)/?$",
			"dest": "_render"
		},
		{
			"src": "^/_image/?$",
			"dest": "_render"
		},
		{
			"src": "^/carrito/?$",
			"dest": "/_isr?x_astro_path=$0"
		},
		{
			"src": "^/checkout/?$",
			"dest": "/_isr?x_astro_path=$0"
		},
		{
			"src": "^/contacto/?$",
			"dest": "/_isr?x_astro_path=$0"
		},
		{
			"src": "^/nosotros/?$",
			"dest": "/_isr?x_astro_path=$0"
		},
		{
			"src": "^/tienda/([^/]+?)/?$",
			"dest": "/_isr?x_astro_path=$0"
		},
		{
			"src": "^/tienda/?$",
			"dest": "/_isr?x_astro_path=$0"
		},
		{
			"src": "^/$",
			"dest": "/_isr?x_astro_path=$0"
		},
		{
			"src": "^/404/?$",
			"dest": "/_isr?x_astro_path=$0"
		},
		{
			"src": "^/.*$",
			"dest": "_render",
			"status": 404
		}
	]
}