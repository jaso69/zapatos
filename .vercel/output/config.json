{
	"version": 3,
	"routes": [
		{
			"handle": "filesystem"
		},
		{
			"src": "^/_astro/(.*)$",
			"headers": {
				"cache-control": "public, max-age=31536000, immutable"
			},
			"continue": true
		},
		{
			"src": "^/_server-islands/([^/]+?)/?$",
			"dest": "_render"
		},
		{
			"src": "^/_image/?$",
			"dest": "_render"
		},
		{
			"src": "^/api/cart/add/?$",
			"dest": "_render"
		},
		{
			"src": "^/api/cart/create/?$",
			"dest": "_render"
		},
		{
			"src": "^/api/cart/get/?$",
			"dest": "_render"
		},
		{
			"src": "^/api/cart/remove/?$",
			"dest": "_render"
		},
		{
			"src": "^/api/cart/update/?$",
			"dest": "_render"
		},
		{
			"src": "^/api/chat/?$",
			"dest": "_render"
		},
		{
			"src": "^/api/checkout/add-shipping/?$",
			"dest": "_render"
		},
		{
			"src": "^/api/checkout/complete/?$",
			"dest": "_render"
		},
		{
			"src": "^/api/checkout/initiate-payment/?$",
			"dest": "_render"
		},
		{
			"src": "^/api/checkout/shipping-options/?$",
			"dest": "_render"
		},
		{
			"src": "^/api/checkout/update-cart/?$",
			"dest": "_render"
		},
		{
			"src": "^/carrito/?$",
			"dest": "_render"
		},
		{
			"src": "^/checkout/?$",
			"dest": "_render"
		},
		{
			"src": "^/contacto/?$",
			"dest": "_render"
		},
		{
			"src": "^/nosotros/?$",
			"dest": "_render"
		},
		{
			"src": "^/pedido-confirmado/?$",
			"dest": "_render"
		},
		{
			"src": "^/personalizacion/?$",
			"dest": "_render"
		},
		{
			"src": "^/sitemap\\.xml$",
			"dest": "_render"
		},
		{
			"src": "^/tienda/([^/]+?)/?$",
			"dest": "_render"
		},
		{
			"src": "^/tienda/?$",
			"dest": "_render"
		},
		{
			"src": "^/$",
			"dest": "_render"
		},
		{
			"src": "^/404/?$",
			"dest": "_render"
		},
		{
			"src": "^/.*$",
			"dest": "_render",
			"status": 404
		}
	]
}