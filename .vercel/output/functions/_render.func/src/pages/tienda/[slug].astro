---
import { getTranslations, type Language } from '../../i18n';
import MainLayout from '../../layouts/MainLayout.astro';
import Header from '../../components/layout/Header.astro';
import Footer from '../../components/layout/Footer.astro';
import { getProductByHandle, formatPrice } from '../../lib/medusa';

const lang: Language = Astro.locals.lang || 'es';
const t = getTranslations(lang);

const { slug } = Astro.params;
const product = await getProductByHandle(slug || '');

if (!product) {
  return Astro.redirect('/tienda');
}

const mainImage = product.images[0];
const thumbnails = product.images.slice(0, 4);
const colorOption = product.options.find(opt => opt.title.toLowerCase() === 'color');
const colors = colorOption?.values || [];
const sizeOption = product.options.find(opt => opt.title.toLowerCase() === 'talla' || opt.title.toLowerCase() === 'size');
const sizes = sizeOption?.values || [];

const ogImage = mainImage?.url || '/og-image.webp';
const metaDescription = product.description?.substring(0, 160) || `${product.title} - Zapatos artesanales hechos a mano en España por Sanvin Shoemakers.`;

const productSchema = {
  "@context": "https://schema.org",
  "@type": "Product",
  "name": product.title,
  "image": product.images.map(img => img.url),
  "description": product.description,
  "sku": product.variants?.[0]?.sku || product.id,
  "brand": {
    "@type": "Brand",
    "name": "Sanvin Shoemakers"
  },
  "offers": {
    "@type": "Offer",
    "url": `https://sanvinshoemakers.com/tienda/${product.handle}`,
    "priceCurrency": product.price?.currency_code || 'EUR',
    "price": product.price ? (product.price.amount / 100).toFixed(2) : '0',
    "availability": "https://schema.org/InStock",
    "seller": {
      "@type": "Organization",
      "name": "Sanvin Shoemakers"
    }
  }
};

const breadcrumbSchema = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    {
      "@type": "ListItem",
      "position": 1,
      "name": t.nav.home,
      "item": "https://sanvinshoemakers.com"
    },
    {
      "@type": "ListItem",
      "position": 2,
      "name": t.nav.shop,
      "item": "https://sanvinshoemakers.com/tienda"
    },
    {
      "@type": "ListItem",
      "position": 3,
      "name": product.title,
      "item": `https://sanvinshoemakers.com/tienda/${product.handle}`
    }
  ]
};
---

<MainLayout title={`${product.title} | Sanvin Shoemakers`} description={metaDescription} ogImage={ogImage} structuredData={[productSchema, breadcrumbSchema]}>
  <Header slot="header" />

  <section class="bg-[var(--color-bg)] py-12 md:py-20">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">

      <!-- Breadcrumb editorial -->
      <nav aria-label="Breadcrumb" class="mb-12 text-[10px] uppercase tracking-[0.3em] text-[var(--color-text-secondary)] flex items-center gap-3">
        <a href="/" class="hover:text-[var(--color-accent-deep)] transition-colors">{t.nav.home}</a>
        <span class="w-4 h-px bg-[var(--color-accent)]/50" aria-hidden="true"></span>
        <a href="/tienda" class="hover:text-[var(--color-accent-deep)] transition-colors">{t.nav.shop}</a>
        <span class="w-4 h-px bg-[var(--color-accent)]/50" aria-hidden="true"></span>
        <span class="text-[var(--color-text)]" aria-current="page">{product.title}</span>
      </nav>

      <div class="grid grid-cols-1 md:grid-cols-12 gap-10 lg:gap-16">
        <!-- ============ Galería ============ -->
        <div class="md:col-span-7">
          <div class="relative w-full aspect-square bg-white rounded-2xl overflow-hidden shadow-lg">
            <!-- Badge -->
            <div class="absolute top-6 left-6 z-10">
              <span class="gold-badge">{t.editorial.handmade}</span>
            </div>
            <!-- Imagen principal -->
            {mainImage ? (
              <div class="w-full h-full flex items-center justify-center p-6">
                <img
                  id="main-image"
                  src={mainImage.url}
                  alt={product.title}
                  class="max-w-full max-h-full object-contain"
                  width="800"
                  height="800"
                />
              </div>
            ) : (
              <div class="w-full h-full flex items-center justify-center text-[var(--color-accent)]/30">
                <svg xmlns="http://www.w3.org/2000/svg" class="h-32 w-32" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="0.6">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M3 17c0-1 1-2 3-2h2c1.5 0 3-1 4-2l3-3c1-1 2-1 3-1h1c1 0 2 1 2 2v3c0 2-1 3-3 3H4c-.5 0-1-.5-1-1zM6 15v2M10 13v2" />
                </svg>
              </div>
            )}
          </div>

          <!-- Thumbnails -->
          {thumbnails.length > 1 && (
            <div class="grid grid-cols-4 gap-3 mt-4" id="thumbnail-grid">
              {thumbnails.map((img, i) => (
                <button
                  type="button"
                  aria-label={`Ver imagen ${i + 1} de ${product.title}`}
                  class={`thumbnail-btn aspect-square bg-white rounded-xl overflow-hidden cursor-pointer transition-all duration-300 ${i === 0 ? 'ring-2 ring-[var(--color-accent)]' : 'hover:ring-2 hover:ring-[var(--color-accent)]/50'}`}
                  data-url={img.url}
                  data-index={i}
                >
                  <div class="w-full h-full flex items-center justify-center p-2">
                    <img src={img.url} alt={`${product.title} - vista ${i + 1}`} class="max-w-full max-h-full object-contain" loading="lazy" width="200" height="200" />
                  </div>
                </button>
              ))}
            </div>
          )}
        </div>

        <!-- ============ Info producto ============ -->
        <div class="md:col-span-5 md:pt-4">
          <!-- Kicker categoría -->
          <span class="kicker kicker--single" style="display: inline-flex">
            {product.collection?.title || t.kickers.collection}
          </span>

          <!-- Título -->
          <h1 class="mt-6 text-3xl md:text-4xl lg:text-5xl font-heading font-medium text-[var(--color-text)] leading-tight">
            {product.title.split(' ').slice(0, -1).join(' ')} <span class="accent-italic text-[var(--color-accent-deep)]">{product.title.split(' ').slice(-1)}</span>
          </h1>

          <div class="gold-divider mt-8" style="max-width: 100%"><span></span></div>

          <!-- Precio -->
          {product.price ? (
            <div class="mt-6 flex items-baseline gap-3">
              <span class="font-heading text-3xl md:text-4xl text-[var(--color-accent-deep)]">
                {formatPrice(product.price.amount, product.price.currency_code)}
              </span>
              <span class="text-xs uppercase tracking-[0.2em] text-[var(--color-text-secondary)]">
                {product.price.currency_code === 'EUR' ? 'IVA incluido · Envío gratis' : 'Tax included · Free shipping'}
              </span>
            </div>
          ) : (
            <div class="mt-6">
              <span class="accent-italic text-lg text-[var(--color-text-secondary)]">
                {t.product.priceOnRequest}
              </span>
            </div>
          )}

          <!-- Descripción -->
          <div class="mt-8 text-base text-[var(--color-text)] leading-relaxed space-y-3">
            {product.description.split('\n').filter(line => line.trim()).map((line) => (
              <p class={line.includes('🔹') ? 'pl-4 border-l-2 border-[var(--color-accent)]/30' : ''}>{line}</p>
            ))}
          </div>

          <!-- Selector de talla (si existe) -->
          {sizes.length > 0 && (
            <div class="mt-10">
              <h3 class="text-[10px] uppercase tracking-[0.3em] text-[var(--color-text)] mb-4">
                {t.product.size}
              </h3>
              <div class="flex flex-wrap gap-2" id="size-selector">
                {sizes.map((size, i) => (
                  <button
                    type="button"
                    aria-label={`Talla ${size.value}`}
                    data-size={size.value}
                    class={`size-btn min-w-[56px] min-h-[44px] px-4 py-2 border text-sm font-medium transition-all duration-300 ${i === 0 ? 'border-[var(--color-accent)] bg-[var(--color-accent)]/10 text-[var(--color-accent-deep)]' : 'border-[var(--color-border)] text-[var(--color-text)] hover:border-[var(--color-accent)] hover:text-[var(--color-accent-deep)]'}`}
                  >
                    {size.value}
                  </button>
                ))}
              </div>
              <p class="mt-3 text-[11px] text-[var(--color-text-secondary)] accent-italic">
                {t.product.sizeGuide || 'Tallas europeas. Consulte nuestra guía de tallas si tiene dudas.'}
              </p>
            </div>
          )}

          <!-- Selector de color (si existe) -->
          {colors.length > 0 && (
            <div class="mt-10">
              <h3 class="text-[10px] uppercase tracking-[0.3em] text-[var(--color-text)] mb-4">
                {t.product.color}
              </h3>
              <div class="flex flex-wrap gap-2" id="color-selector">
                {colors.map((color, i) => (
                  <button
                    type="button"
                    aria-label={`Color ${color.value}`}
                    data-color={color.value}
                    class={`color-btn px-4 py-2 border text-sm font-medium transition-all duration-300 ${i === 0 ? 'border-[var(--color-accent)] bg-[var(--color-accent)]/10 text-[var(--color-accent-deep)]' : 'border-[var(--color-border)] text-[var(--color-text)] hover:border-[var(--color-accent)] hover:text-[var(--color-accent-deep)]'}`}
                  >
                    {color.value}
                  </button>
                ))}
              </div>
            </div>
          )}

          <!-- Botón añadir al carrito -->
          <div class="mt-12 flex gap-3">
            <button
              id="add-to-cart-btn"
              type="button"
              class="btn-fill arrow-slide flex-1 inline-flex items-center justify-center gap-3 min-h-[56px] px-8 py-4 bg-[var(--color-brand-700)] text-white font-medium text-xs uppercase tracking-[0.25em] hover:text-white transition-colors duration-300 disabled:opacity-50 disabled:cursor-not-allowed"
              data-product-id={product.id}
              data-variants={JSON.stringify(product.variants)}
              data-options={JSON.stringify(product.options)}
            >
              <span id="add-to-cart-text">{t.product.addToCart}</span>
              <svg id="add-to-cart-icon" xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
                <path stroke-linecap="round" stroke-linejoin="round" d="M16 11V7a4 4 0 00-8 0v4M5 9h14l1 12H4L5 9z" />
              </svg>
              <svg id="add-to-cart-spinner" xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 hidden animate-spin" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
                <path stroke-linecap="round" stroke-linejoin="round" d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15" />
              </svg>
            </button>
            <a
              href="/personalizacion"
              aria-label="Personalizar"
              class="min-w-[56px] min-h-[56px] border border-[var(--color-accent)]/40 hover:border-[var(--color-accent)] hover:bg-[var(--color-accent)]/5 transition-all duration-300 flex items-center justify-center text-[var(--color-accent-deep)]"
            >
              <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
                <path stroke-linecap="round" stroke-linejoin="round" d="M15.232 5.232l3.536 3.536m-2.036-5.036a2.5 2.5 0 113.536 3.536L6.5 21.036H3v-3.572L16.732 3.732z" />
              </svg>
            </a>
          </div>

          <!-- Mensaje de error/validación -->
          <p id="cart-message" class="mt-3 text-sm text-red-500 hidden"></p>

          <!-- Detalles -->
          <div class="mt-10 pt-10 border-t border-[var(--color-border)] space-y-5">
            <div class="flex items-center justify-between gap-4">
              <div class="flex items-center gap-3">
                <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 text-[var(--color-accent-deep)]" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.2">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M3 9l2 2 4-4M3 15l2 2 4-4M13 6h8M13 12h8M13 18h8" />
                </svg>
                <span class="text-sm text-[var(--color-text)]">{t.shop.freeShipping}</span>
              </div>
              <span class="accent-italic text-sm text-[var(--color-text-secondary)]">{t.shop.freeShippingCondition}</span>
            </div>
            <div class="flex items-center justify-between gap-4">
              <div class="flex items-center gap-3">
                <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 text-[var(--color-accent-deep)]" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.2">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15" />
                </svg>
                <span class="text-sm text-[var(--color-text)]">{t.shop.returns}</span>
              </div>
              <span class="accent-italic text-sm text-[var(--color-text-secondary)]">{t.shop.returnsDays}</span>
            </div>
            <div class="flex items-center justify-between gap-4">
              <div class="flex items-center gap-3">
                <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 text-[var(--color-accent-deep)]" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.2">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z" />
                </svg>
                <span class="text-sm text-[var(--color-text)]">{t.shop.warranty}</span>
              </div>
              <span class="accent-italic text-sm text-[var(--color-text-secondary)]">{t.shop.warrantyYears}</span>
            </div>
          </div>

          <!-- Heritage tagline -->
          <p class="mt-12 accent-italic text-sm text-[var(--color-text-secondary)]/80 text-center">
            — {t.editorial.crafted} · {t.editorial.estLabel} {t.editorial.estYear}
          </p>
        </div>
      </div>
    </div>
  </section>

  <Footer slot="footer" />
</MainLayout>

<script define:vars={{
  addToCartLabel: t.product.addToCart,
  addedToCartLabel: t.product.addedToCart,
  toastTitle: t.product.toastTitle,
  toastMessage: t.product.toastMessage,
  addError: t.product.addError,
  notAvailable: t.product.notAvailable,
  cartCreateError: t.product.cartCreateError,
}}>
  (function() {
    function updateCartCount(cart) {
      const countEl = document.getElementById('cart-count');
      if (!countEl || !cart || !cart.items) return;
      const total = cart.items.reduce(function(sum, item) { return sum + item.quantity; }, 0);
      countEl.textContent = total;
      countEl.classList.toggle('hidden', total === 0);
    }

    async function createCart() {
      try {
        const response = await fetch('/api/cart/create', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
        });
        if (!response.ok) {
          console.error('createCart failed:', response.status, response.statusText);
          return null;
        }
        const data = await response.json();
        return data.cart || null;
      } catch (e) {
        console.error('createCart error:', e);
        return null;
      }
    }

    async function getCart(cartId) {
      try {
        const response = await fetch('/api/cart/get', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ cartId: cartId }),
        });
        if (!response.ok) {
          console.error('getCart failed:', response.status, cartId);
          return null;
        }
        const data = await response.json();
        return data.cart || null;
      } catch (e) {
        console.error('getCart error:', e);
        return null;
      }
    }

    async function addToCart(cartId, variantId, quantity, metadata) {
      try {
        const body = { cartId: cartId, variantId: variantId, quantity: quantity || 1 };
        if (metadata) body.metadata = metadata;
        const response = await fetch('/api/cart/add', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify(body),
        });
        if (!response.ok) {
          console.error('addToCart failed:', response.status, response.statusText);
          const errText = await response.text();
          console.error('addToCart error body:', errText);
          return null;
        }
        const data = await response.json();
        return data.cart || null;
      } catch (e) {
        console.error('addToCart error:', e);
        return null;
      }
    }

    async function initCart() {
      let cartId = localStorage.getItem('cart_id');
      console.log('initCart: cartId from localStorage:', cartId);
      let cart = null;
      if (cartId) {
        cart = await getCart(cartId);
        console.log('initCart: getCart result:', cart ? 'ok' : 'null');
        if (!cart) {
          // Invalid cartId, clear it
          localStorage.removeItem('cart_id');
          cartId = null;
        }
      }
      if (!cart) {
        cart = await createCart();
        console.log('initCart: createCart result:', cart ? 'ok' : 'null');
        if (cart) {
          cartId = cart.id;
          localStorage.setItem('cart_id', cartId);
        }
      }
      if (cart) {
        updateCartCount(cart);
      }
      console.log('initCart: final cartId:', cartId);
      return cartId;
    }

    document.addEventListener('DOMContentLoaded', function() {
      const mainImage = document.getElementById('main-image');
      const thumbnailGrid = document.getElementById('thumbnail-grid');
      if (mainImage && thumbnailGrid) {
        const buttons = thumbnailGrid.querySelectorAll('.thumbnail-btn');
        buttons.forEach(function(btn) {
          btn.addEventListener('click', function() {
            const url = btn.getAttribute('data-url');
            if (!url) return;
            mainImage.src = url;
            buttons.forEach(function(b) {
              b.classList.remove('ring-2', 'ring-[var(--color-accent)]');
              b.classList.add('hover:ring-2', 'hover:ring-[var(--color-accent)]/50');
            });
            btn.classList.remove('hover:ring-2', 'hover:ring-[var(--color-accent)]/50');
            btn.classList.add('ring-2', 'ring-[var(--color-accent)]');
          });
        });
      }

      // Size selector
      let selectedSize = null;
      const sizeSelector = document.getElementById('size-selector');
      if (sizeSelector) {
        const sizeButtons = sizeSelector.querySelectorAll('.size-btn');
        if (sizeButtons.length > 0) {
          selectedSize = sizeButtons[0].getAttribute('data-size');
        }
        sizeButtons.forEach(function(btn) {
          btn.addEventListener('click', function() {
            sizeButtons.forEach(function(b) {
              b.classList.remove('border-[var(--color-accent)]', 'bg-[var(--color-accent)]/10', 'text-[var(--color-accent-deep)]');
              b.classList.add('border-[var(--color-border)]', 'text-[var(--color-text)]');
            });
            btn.classList.remove('border-[var(--color-border)]', 'text-[var(--color-text)]');
            btn.classList.add('border-[var(--color-accent)]', 'bg-[var(--color-accent)]/10', 'text-[var(--color-accent-deep)]');
            selectedSize = btn.getAttribute('data-size');
          });
        });
      }

      // Color selector
      let selectedColor = null;
      const colorSelector = document.getElementById('color-selector');
      if (colorSelector) {
        const colorButtons = colorSelector.querySelectorAll('.color-btn');
        if (colorButtons.length > 0) {
          selectedColor = colorButtons[0].getAttribute('data-color');
        }
        colorButtons.forEach(function(btn) {
          btn.addEventListener('click', function() {
            colorButtons.forEach(function(b) {
              b.classList.remove('border-[var(--color-accent)]', 'bg-[var(--color-accent)]/10', 'text-[var(--color-accent-deep)]');
              b.classList.add('border-[var(--color-border)]', 'text-[var(--color-text)]');
            });
            btn.classList.remove('border-[var(--color-border)]', 'text-[var(--color-text)]');
            btn.classList.add('border-[var(--color-accent)]', 'bg-[var(--color-accent)]/10', 'text-[var(--color-accent-deep)]');
            selectedColor = btn.getAttribute('data-color');
          });
        });
      }

      // Initialize cart count on load
      initCart();

      // Add to cart button
      const addBtn = document.getElementById('add-to-cart-btn');
      if (addBtn) {
        const variants = JSON.parse(addBtn.getAttribute('data-variants') || '[]');
        const options = JSON.parse(addBtn.getAttribute('data-options') || '[]');
        const addText = document.getElementById('add-to-cart-text');
        const addIcon = document.getElementById('add-to-cart-icon');
        const addSpinner = document.getElementById('add-to-cart-spinner');
        const cartMessage = document.getElementById('cart-message');

        addBtn.addEventListener('click', async function() {
          console.log('Add to cart clicked');
          console.log('variants:', variants);
          console.log('options:', options);
          console.log('selectedSize:', selectedSize);
          console.log('selectedColor:', selectedColor);

          // Validate selections
          const sizeOption = options.find(function(o) { return o.title.toLowerCase() === 'talla' || o.title.toLowerCase() === 'size'; });
          const colorOption = options.find(function(o) { return o.title.toLowerCase() === 'color'; });

          if (sizeOption && !selectedSize) {
            if (cartMessage) { cartMessage.textContent = 'Seleccione una talla'; cartMessage.classList.remove('hidden'); }
            return;
          }
          if (colorOption && !selectedColor) {
            if (cartMessage) { cartMessage.textContent = 'Seleccione un color'; cartMessage.classList.remove('hidden'); }
            return;
          }
          if (cartMessage) cartMessage.classList.add('hidden');

          // Find matching variant
          let variantId = null;
          for (let i = 0; i < variants.length; i++) {
            const v = variants[i];
            let match = true;
            if (sizeOption && selectedSize) {
              const sizeMatch = v.options.find(function(o) { return o.option_id === sizeOption.id && o.value === selectedSize; });
              if (!sizeMatch) match = false;
            }
            if (colorOption && selectedColor) {
              const colorMatch = v.options.find(function(o) { return o.option_id === colorOption.id && o.value === selectedColor; });
              if (!colorMatch) match = false;
            }
            if (match) {
              variantId = v.id;
              break;
            }
          }

          // Fallback: if no exact match, use first available variant
          // (Medusa backend currently has only 1 "default" variant per product,
          //  so we use it and pass the selected size/color as metadata)
          if (!variantId && variants.length > 0) {
            variantId = variants[0].id;
          }

          if (!variantId) {
            if (cartMessage) { cartMessage.textContent = notAvailable; cartMessage.classList.remove('hidden'); }
            return;
          }

          // Build metadata with selected size/color
          const metadata = {};
          if (selectedSize) metadata.talla = selectedSize;
          if (selectedColor) metadata.color = selectedColor;

          // Loading state
          addBtn.disabled = true;
          if (addIcon) addIcon.classList.add('hidden');
          if (addSpinner) addSpinner.classList.remove('hidden');

          // Get or create cart
          let cartId = localStorage.getItem('cart_id');
          console.log('click: cartId from localStorage:', cartId);
          let cart = null;
          if (cartId) {
            cart = await getCart(cartId);
            console.log('click: getCart result:', cart ? 'ok' : 'null');
            if (!cart) {
              localStorage.removeItem('cart_id');
              cartId = null;
            }
          }
          if (!cart) {
            cart = await createCart();
            console.log('click: createCart result:', cart ? 'ok' : 'null');
            if (cart) {
              cartId = cart.id;
              localStorage.setItem('cart_id', cartId);
            }
          }
          console.log('click: final cartId:', cartId);

          if (!cartId) {
            if (cartMessage) { cartMessage.textContent = cartCreateError; cartMessage.classList.remove('hidden'); }
            addBtn.disabled = false;
            if (addIcon) addIcon.classList.remove('hidden');
            if (addSpinner) addSpinner.classList.add('hidden');
            return;
          }

          // Add to cart
          const updatedCart = await addToCart(cartId, variantId, 1, Object.keys(metadata).length > 0 ? metadata : undefined);

          if (updatedCart) {
            updateCartCount(updatedCart);
            if (addText) addText.textContent = addedToCartLabel;
            if (addIcon) addIcon.classList.remove('hidden');
            if (addSpinner) addSpinner.classList.add('hidden');

            // Show toast
            if (window.sanvinToast) {
              window.sanvinToast({ title: toastTitle, message: toastMessage, duration: 3000 });
            }

            // Reset button after 2s
            setTimeout(function() {
              if (addText) addText.textContent = addToCartLabel;
              addBtn.disabled = false;
            }, 2000);
          } else {
            if (cartMessage) { cartMessage.textContent = addError; cartMessage.classList.remove('hidden'); }
            addBtn.disabled = false;
            if (addIcon) addIcon.classList.remove('hidden');
            if (addSpinner) addSpinner.classList.add('hidden');
          }
        });
      }
    });
  })();
</script>
