---
import { getTranslations, type Language } from '../../i18n';
import MainLayout from '../../layouts/MainLayout.astro';
import Header from '../../components/layout/Header.astro';
import Footer from '../../components/layout/Footer.astro';
import { getProducts, formatPrice } from '../../lib/medusa';

const lang: Language = Astro.locals.lang || 'es';
const t = getTranslations(lang);

const products = await getProducts();
---

<MainLayout title={`${t.shop.title} | Sanvin Shoemakers`}>
  <Header slot="header" />

  <!-- Hero pequeño -->
  <section class="relative bg-[var(--color-bg-secondary)] texture-paper py-16 md:py-24 overflow-hidden">
    <div class="absolute top-12 right-12 editorial-num text-[6rem] opacity-20 hidden lg:block">·</div>
    <div class="max-w-5xl mx-auto px-6 text-center">
      <span class="kicker">{t.kickers.collection}</span>
      <h1 class="mt-6 text-4xl md:text-6xl font-heading font-medium text-[var(--color-text)] leading-tight">
        {t.shop.title.split(' ').slice(0, -1).join(' ')} <span class="accent-italic text-[var(--color-accent-deep)]">{t.shop.title.split(' ').slice(-1)}</span>
      </h1>
      <div class="gold-divider mt-8"><span></span></div>
      <p class="mt-8 accent-italic text-lg md:text-xl text-[var(--color-text-secondary)]">{t.shop.subtitle}</p>
    </div>
  </section>

  <!-- Sección productos -->
  <section class="py-16 md:py-24 bg-[var(--color-bg)]">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">

      <!-- Filtros (futuro: integrar categorías) -->
      <div class="flex flex-wrap gap-2 mb-16 justify-center">
        <button class="px-6 py-2 bg-[var(--color-brand-900)] text-[var(--color-brand-50)] text-[11px] uppercase tracking-[0.25em] font-medium rounded-full hover:bg-[var(--color-brand-950)] transition-colors duration-300">
          {t.shop.filterAll}
        </button>
      </div>

      <!-- Grid productos -->
      <ul class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4 gap-8 lg:gap-10 list-none p-0">
        {products.length === 0 && (
          <li class="col-span-full text-center py-20">
            <p class="accent-italic text-lg text-[var(--color-text-secondary)]">
              Próximamente nuevos modelos
            </p>
          </li>
        )}
        {products.map((product, i) => {
          const mainImage = product.images[0];
          const isNew = i === 0;
          return (
            <li class="list-none">
            <article>
            <a href={`/tienda/${product.handle}`} class="group block">
              <div class="relative w-full aspect-square bg-white rounded-2xl overflow-hidden mb-5 shadow-sm hover:shadow-xl transition-shadow duration-500">
                {isNew && (
                  <div class="absolute top-4 left-4 z-10">
                    <span class="gold-badge">{t.editorial.new}</span>
                  </div>
                )}
                <div class="absolute top-4 right-4 z-10 accent-italic text-[10px] text-white/90 drop-shadow-lg">
                  Nº {String(i + 1).padStart(3, '0')}
                </div>
                {mainImage ? (
                  <div class="w-full h-full flex items-center justify-center p-4">
                    <img
                      src={mainImage.url}
                      alt={product.title}
                      class="max-w-full max-h-full object-contain group-hover:scale-105 transition-transform duration-700 ease-out"
                      loading="lazy"
                      width="400"
                      height="400"
                    />
                  </div>
                ) : (
                  <div class="w-full h-full flex items-center justify-center text-[var(--color-accent)]/30 group-hover:scale-105 transition-transform duration-700 ease-out">
                    <svg xmlns="http://www.w3.org/2000/svg" class="h-20 w-20" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="0.8">
                      <path stroke-linecap="round" stroke-linejoin="round" d="M3 17c0-1 1-2 3-2h2c1.5 0 3-1 4-2l3-3c1-1 2-1 3-1h1c1 0 2 1 2 2v3c0 2-1 3-3 3H4c-.5 0-1-.5-1-1zM6 15v2M10 13v2" />
                    </svg>
                  </div>
                )}
              </div>

              <div class="px-2">
                <p class="accent-italic text-xs text-[var(--color-accent-deep)] mb-1">
                  {product.collection?.title || t.kickers.collection}
                </p>
                <h3 class="font-heading font-medium text-lg text-[var(--color-text)] group-hover:text-[var(--color-accent-deep)] transition-colors duration-300">
                  {product.title}
                </h3>
                <div class="mt-2 flex items-center justify-between">
                  {product.price ? (
                    <span class="font-heading text-lg text-[var(--color-accent-deep)]">
                      {formatPrice(product.price.amount, product.price.currency_code)}
                    </span>
                  ) : (
                    <span class="text-[10px] uppercase tracking-[0.2em] text-[var(--color-text-secondary)]">
                      {t.product.priceOnRequest}
                    </span>
                  )}
                  <span class="text-[10px] uppercase tracking-[0.2em] text-[var(--color-text-secondary)] group-hover:text-[var(--color-accent-deep)] transition-colors duration-300">
                    Ver detalles →
                  </span>
                </div>
              </div>
            </a>
            </article>
            </li>
          );
        })}
      </ul>
    </div>
  </section>

  <Footer slot="footer" />
</MainLayout>
