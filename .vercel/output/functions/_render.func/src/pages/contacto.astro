---
import { getTranslations, type Language } from '../i18n';
import MainLayout from '../layouts/MainLayout.astro';
import Header from '../components/layout/Header.astro';
import Footer from '../components/layout/Footer.astro';
import ContactChat from '../components/ContactChat.tsx';

const lang: Language = Astro.locals.lang || 'es';
const t = getTranslations(lang);
---

<MainLayout title={`${t.contact.title} | Sanvin Shoemakers`}>
  <Header slot="header" />

  <!-- ============================================
       HERO Editorial — Contacto
       ============================================ -->
  <section class="relative bg-[var(--color-bg-secondary)] texture-paper py-20 md:py-28 overflow-hidden">
    <div class="absolute inset-0 flex items-center justify-center pointer-events-none overflow-hidden">
      <span class="watermark block leading-none whitespace-nowrap" style="font-size: clamp(8rem, 20vw, 18rem)">Contacto</span>
    </div>

    <div class="relative max-w-5xl mx-auto px-6 text-center">
      <div class="reveal-word" style="animation-delay: 0.1s">
        <span class="kicker">{t.kickers.atelier}</span>
      </div>

      <h1 class="mt-8 font-heading font-medium leading-[0.95] tracking-tight text-[var(--color-text)]" style="font-size: clamp(2.5rem, 7vw, 5rem)"
        set:html={t.contact.heroTitle}
      />

      <div class="gold-divider mt-10"><span></span></div>

      <p class="mt-10 accent-italic text-lg md:text-xl text-[var(--color-text-secondary)] max-w-2xl mx-auto leading-relaxed">
        {t.contact.subtitle}
      </p>
    </div>
  </section>

  <!-- ============================================
       Chat + Info — split asimétrico
       ============================================ -->
  <section class="relative py-20 md:py-28 bg-[var(--color-bg)] animate-on-scroll overflow-hidden">
    <div class="hidden lg:block absolute top-16 right-12 editorial-num text-[6rem] opacity-30">01</div>

    <div class="max-w-6xl mx-auto px-6 lg:px-12 grid grid-cols-1 lg:grid-cols-2 gap-12 lg:gap-16">
      <!-- Chat con marco oro -->
      <div>
        <span class="kicker">{t.kickers.voices}</span>
        <h2 class="mt-6 text-2xl md:text-3xl font-heading font-medium text-[var(--color-text)] mb-8 leading-tight"
          set:html={t.contact.chatTitle}
        />

        <div class="relative">
          <div class="absolute -top-3 -left-3 w-12 h-12 border-l border-t border-[var(--color-accent)] pointer-events-none z-10"></div>
          <div class="absolute -bottom-3 -right-3 w-12 h-12 border-r border-b border-[var(--color-accent)] pointer-events-none z-10"></div>
          <ContactChat client:load t={t.chat.contact} />
        </div>
      </div>

      <!-- Info contacto -->
      <div class="lg:pl-8">
        <span class="kicker">{t.kickers.heritage}</span>
        <h2 class="mt-6 text-2xl md:text-3xl font-heading font-medium text-[var(--color-text)] mb-10 leading-tight">
          {t.contact.infoTitle.split(' ').slice(0, -1).join(' ')} <span class="accent-italic text-[var(--color-accent-deep)]">{t.contact.infoTitle.split(' ').slice(-1) || t.contact.infoTitle}</span>
        </h2>

        <div class="space-y-8">
          <!-- Dirección -->
          <div class="flex gap-5 group">
            <div class="contact-circle flex-shrink-0 w-12 h-12 rounded-full border border-[var(--color-accent)]/40 flex items-center justify-center text-[var(--color-accent-deep)] group-hover:border-[var(--color-accent)] group-hover:bg-[var(--color-accent)]/5 transition-all duration-300">
              <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.2">
                <path stroke-linecap="round" stroke-linejoin="round" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z" />
                <path stroke-linecap="round" stroke-linejoin="round" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z" />
              </svg>
            </div>
            <div class="pt-1">
              <h3 class="text-[10px] uppercase tracking-[0.3em] text-[var(--color-text-secondary)] mb-1">{t.contact.address}</h3>
              <p class="accent-italic text-lg text-[var(--color-text)]">{t.contact.addressValue}</p>
            </div>
          </div>

          <div class="w-full h-px bg-[var(--color-border)]"></div>

          <!-- Email -->
          <div class="flex gap-5 group">
            <div class="contact-circle flex-shrink-0 w-12 h-12 rounded-full border border-[var(--color-accent)]/40 flex items-center justify-center text-[var(--color-accent-deep)] group-hover:border-[var(--color-accent)] group-hover:bg-[var(--color-accent)]/5 transition-all duration-300">
              <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.2">
                <path stroke-linecap="round" stroke-linejoin="round" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" />
              </svg>
            </div>
            <div class="pt-1">
              <h3 class="text-[10px] uppercase tracking-[0.3em] text-[var(--color-text-secondary)] mb-1">{t.contact.email}</h3>
              <a href={`mailto:${t.contact.emailValue}`} class="accent-italic text-lg text-[var(--color-text)] hover:text-[var(--color-accent-deep)] transition-colors duration-300">{t.contact.emailValue}</a>
            </div>
          </div>

          <div class="w-full h-px bg-[var(--color-border)]"></div>

          <!-- Teléfono -->
          <div class="flex gap-5 group">
            <div class="contact-circle flex-shrink-0 w-12 h-12 rounded-full border border-[var(--color-accent)]/40 flex items-center justify-center text-[var(--color-accent-deep)] group-hover:border-[var(--color-accent)] group-hover:bg-[var(--color-accent)]/5 transition-all duration-300">
              <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.2">
                <path stroke-linecap="round" stroke-linejoin="round" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z" />
              </svg>
            </div>
            <div class="pt-1">
              <h3 class="text-[10px] uppercase tracking-[0.3em] text-[var(--color-text-secondary)] mb-1">{t.contact.phone}</h3>
              <a href={`tel:${t.contact.phoneValue.replace(/\s/g, '')}`} class="accent-italic text-lg text-[var(--color-text)] hover:text-[var(--color-accent-deep)] transition-colors duration-300">{t.contact.phoneValue}</a>
            </div>
          </div>

          <div class="w-full h-px bg-[var(--color-border)]"></div>

          <!-- Horario -->
          <div class="flex gap-5 group">
            <div class="contact-circle flex-shrink-0 w-12 h-12 rounded-full border border-[var(--color-accent)]/40 flex items-center justify-center text-[var(--color-accent-deep)] group-hover:border-[var(--color-accent)] group-hover:bg-[var(--color-accent)]/5 transition-all duration-300">
              <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.2">
                <path stroke-linecap="round" stroke-linejoin="round" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z" />
              </svg>
            </div>
            <div class="pt-1">
              <h3 class="text-[10px] uppercase tracking-[0.3em] text-[var(--color-text-secondary)] mb-1">{t.contact.hours}</h3>
              <p class="accent-italic text-base text-[var(--color-text)]">{t.contact.hoursWeekday}</p>
              <p class="accent-italic text-base text-[var(--color-text-secondary)]">{t.contact.hoursSaturday}</p>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <Footer slot="footer" />
</MainLayout>
