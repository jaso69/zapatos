---
import { getTranslations, type Language } from '../i18n';
import MainLayout from '../layouts/MainLayout.astro';
import Header from '../components/layout/Header.astro';
import Footer from '../components/layout/Footer.astro';

const lang: Language = Astro.locals.lang || 'es';
const t = getTranslations(lang);
---

<MainLayout title={`${t.cart.title} | ZAPATOS`}>
  <Header slot="header" />

  <section class="py-12 md:py-16">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
      <h1 class="text-3xl font-heading font-bold text-[var(--color-text)] mb-8">
        {t.cart.title}
      </h1>

      <!-- Contenido del carrito (se conectará con React + nanostores) -->
      <div id="cart-container">
        <div class="text-center py-16 text-[var(--color-text-secondary)]">
          <svg xmlns="http://www.w3.org/2000/svg" class="h-16 w-16 mx-auto mb-4 text-[var(--color-border)]" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1">
            <path stroke-linecap="round" stroke-linejoin="round" d="M16 11V7a4 4 0 00-8 0v4M5 9h14l1 12H4L5 9z" />
          </svg>
          <p class="text-lg">{t.cart.empty}</p>
          <a href="/tienda" class="inline-block mt-4 text-brand-600 font-medium hover:underline">
            {t.cart.explore}
          </a>
        </div>
      </div>
    </div>
  </section>

  <Footer slot="footer" />
</MainLayout>