---
import { getTranslations, type Language } from '../i18n';
import MainLayout from '../layouts/MainLayout.astro';
import Header from '../components/layout/Header.astro';
import Footer from '../components/layout/Footer.astro';

const lang: Language = Astro.locals.lang || 'es';
const t = getTranslations(lang);
---

<MainLayout title={`${t.contact.title} | ZAPATOS`}>
  <Header slot="header" />

  <section class="py-12 md:py-16">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center mb-12">
        <h1 class="text-3xl md:text-4xl font-heading font-bold text-[var(--color-text)]">
          {t.contact.title}
        </h1>
        <p class="mt-4 text-[var(--color-text-secondary)]">
          {t.contact.subtitle}
        </p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 gap-12 max-w-5xl mx-auto">
        <!-- Formulario -->
        <div>
          <h2 class="text-xl font-heading font-semibold mb-6 text-[var(--color-text)]">{t.contact.formTitle}</h2>
          <form class="space-y-4">
            <div>
              <label class="block text-sm font-medium text-[var(--color-text)] mb-1">{t.contact.formName}</label>
              <input
                type="text"
                class="w-full px-4 py-2 border border-[var(--color-border)] rounded bg-[var(--color-bg)] text-[var(--color-text)] focus:ring-2 focus:ring-brand-500 focus:border-transparent outline-none"
                placeholder={t.contact.formPlaceholderName}
              />
            </div>
            <div>
              <label class="block text-sm font-medium text-[var(--color-text)] mb-1">{t.contact.formEmail}</label>
              <input
                type="email"
                class="w-full px-4 py-2 border border-[var(--color-border)] rounded bg-[var(--color-bg)] text-[var(--color-text)] focus:ring-2 focus:ring-brand-500 focus:border-transparent outline-none"
                placeholder={t.contact.formPlaceholderEmail}
              />
            </div>
            <div>
              <label class="block text-sm font-medium text-[var(--color-text)] mb-1">{t.contact.formSubject}</label>
              <input
                type="text"
                class="w-full px-4 py-2 border border-[var(--color-border)] rounded bg-[var(--color-bg)] text-[var(--color-text)] focus:ring-2 focus:ring-brand-500 focus:border-transparent outline-none"
                placeholder={t.contact.formPlaceholderSubject}
              />
            </div>
            <div>
              <label class="block text-sm font-medium text-[var(--color-text)] mb-1">{t.contact.formMessage}</label>
              <textarea
                rows="5"
                class="w-full px-4 py-2 border border-[var(--color-border)] rounded bg-[var(--color-bg)] text-[var(--color-text)] focus:ring-2 focus:ring-brand-500 focus:border-transparent outline-none resize-none"
                placeholder={t.contact.formPlaceholderMessage}
              ></textarea>
            </div>
            <button
              type="submit"
              class="w-full py-3 bg-brand-600 text-white font-medium text-sm uppercase tracking-wider rounded hover:bg-brand-700 transition-colors"
            >
              {t.contact.formSubmit}
            </button>
          </form>
        </div>

        <!-- Info de contacto -->
        <div>
          <h2 class="text-xl font-heading font-semibold mb-6 text-[var(--color-text)]">{t.contact.infoTitle}</h2>
          <div class="space-y-6">
            <div class="flex gap-4">
              <div class="flex-shrink-0 w-10 h-10 bg-brand-100 rounded-full flex items-center justify-center">
                <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 text-brand-600" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z" />
                  <path stroke-linecap="round" stroke-linejoin="round" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z" />
                </svg>
              </div>
              <div>
                <h3 class="font-medium text-[var(--color-text)]">{t.contact.address}</h3>
                <p class="text-sm text-[var(--color-text-secondary)] mt-1">{t.contact.addressValue}</p>
              </div>
            </div>

            <div class="flex gap-4">
              <div class="flex-shrink-0 w-10 h-10 bg-brand-100 rounded-full flex items-center justify-center">
                <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 text-brand-600" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" />
                </svg>
              </div>
              <div>
                <h3 class="font-medium text-[var(--color-text)]">{t.contact.email}</h3>
                <p class="text-sm text-[var(--color-text-secondary)] mt-1">{t.contact.emailValue}</p>
              </div>
            </div>

            <div class="flex gap-4">
              <div class="flex-shrink-0 w-10 h-10 bg-brand-100 rounded-full flex items-center justify-center">
                <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 text-brand-600" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z" />
                </svg>
              </div>
              <div>
                <h3 class="font-medium text-[var(--color-text)]">{t.contact.phone}</h3>
                <p class="text-sm text-[var(--color-text-secondary)] mt-1">{t.contact.phoneValue}</p>
              </div>
            </div>

            <div class="flex gap-4">
              <div class="flex-shrink-0 w-10 h-10 bg-brand-100 rounded-full flex items-center justify-center">
                <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 text-brand-600" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z" />
                </svg>
              </div>
              <div>
                <h3 class="font-medium text-[var(--color-text)]">{t.contact.hours}</h3>
                <p class="text-sm text-[var(--color-text-secondary)] mt-1">{t.contact.hoursWeekday}</p>
                <p class="text-sm text-[var(--color-text-secondary)]">{t.contact.hoursSaturday}</p>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <Footer slot="footer" />
</MainLayout>