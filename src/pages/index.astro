<!-- Video Lightbox Modal -->
<div id="video-modal" class="video-modal fixed inset-0 z-50 hidden items-center justify-center" aria-hidden="true">
  <!-- Backdrop con gradiente sutil -->
  <div class="video-modal-backdrop absolute inset-0 bg-[var(--color-brand-950)]/90 backdrop-blur-xl"></div>
  
  <div class="relative w-full max-w-5xl mx-4 video-modal-inner" id="video-modal-content">
    <!-- Botón cerrar -->
    <button
      id="video-modal-close"
      aria-label="Cerrar video"
      class="absolute -top-14 right-0 text-[var(--color-brand-100)] hover:text-[var(--color-accent)] transition-all duration-300 hover:rotate-90"
    >
      <svg xmlns="http://www.w3.org/2000/svg" class="h-8 w-8" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
        <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" />
      </svg>
    </button>
    <!-- Video container -->
    <div class="relative w-full bg-[var(--color-brand-950)] rounded-xl overflow-hidden shadow-[0_0_60px_-15px_rgba(201,169,97,0.3)] border border-[var(--color-accent)]/20">
      <video
        id="modal-video"
        class="w-full h-auto max-h-[80vh]"
        controls
        playsinline
        preload="auto"
      >
        <source id="modal-video-source" src="" type="video/mp4" />
      </video>
    </div>
    <!-- Título del video -->
    <p id="modal-video-title" class="mt-6 text-center text-lg text-[var(--color-brand-100)] accent-italic opacity-0 translate-y-4 transition-all duration-500 delay-200"></p>
  </div>
</div>

<style>
  /* Transiciones elegantes del modal */
  .video-modal {
    transition: visibility 0s linear 0.4s;
  }
  .video-modal.active {
    transition: visibility 0s linear 0s;
  }
  .video-modal-backdrop {
    opacity: 0;
    transition: opacity 0.4s cubic-bezier(0.4, 0, 0.2, 1);
  }
  .video-modal.active .video-modal-backdrop {
    opacity: 1;
  }
  .video-modal-inner {
    transform: scale(0.9) translateY(20px);
    opacity: 0;
    transition: transform 0.5s cubic-bezier(0.34, 1.56, 0.64, 1), opacity 0.4s cubic-bezier(0.4, 0, 0.2, 1);
  }
  .video-modal.active .video-modal-inner {
    transform: scale(1) translateY(0);
    opacity: 1;
  }
  .video-modal.active #modal-video-title {
    opacity: 1;
    transform: translateY(0);
  }
</style>

<script is:inline>
  document.addEventListener('DOMContentLoaded', function() {
    const modal = document.getElementById('video-modal');
    const modalContent = document.getElementById('video-modal-content');
    const modalVideo = document.getElementById('modal-video');
    const modalSource = document.getElementById('modal-video-source');
    const modalTitle = document.getElementById('modal-video-title');
    const closeBtn = document.getElementById('video-modal-close');
    const galleryVideos = document.querySelectorAll('[data-video]');
    let isOpen = false;
    let lastFocusedElement = null;

    function getFocusableElements() {
      return modal.querySelectorAll('button, [href], input, select, textarea, [tabindex]:not([tabindex="-1"]), video');
    }

    function trapFocus(e) {
      const focusable = getFocusableElements();
      if (focusable.length === 0) return;
      const first = focusable[0];
      const last = focusable[focusable.length - 1];
      if (e.key === 'Tab') {
        if (e.shiftKey && document.activeElement === first) {
          e.preventDefault();
          last.focus();
        } else if (!e.shiftKey && document.activeElement === last) {
          e.preventDefault();
          first.focus();
        }
      }
    }

    function openModal(src, title, triggerEl) {
      if (isOpen) return;
      isOpen = true;
      lastFocusedElement = triggerEl || document.activeElement;
      modalSource.src = src;
      modalVideo.load();
      modalTitle.textContent = title;
      modal.classList.remove('hidden');
      modal.classList.add('flex');
      // Trigger reflow for CSS transition
      void modal.offsetWidth;
      modal.classList.add('active');
      modal.setAttribute('aria-hidden', 'false');
      document.body.style.overflow = 'hidden';
      // Auto-play with slight delay for smooth entrance
      setTimeout(() => {
        modalVideo.play().catch(() => {});
      }, 300);
      // Focus trap
      document.addEventListener('keydown', trapFocus);
      // Focus close button
      setTimeout(() => closeBtn.focus(), 100);
    }

    function closeModal() {
      if (!isOpen) return;
      isOpen = false;
      modal.classList.remove('active');
      modalVideo.pause();
      modalVideo.currentTime = 0;
      document.removeEventListener('keydown', trapFocus);
      setTimeout(() => {
        modal.classList.add('hidden');
        modal.classList.remove('flex');
        modalSource.src = '';
        modalVideo.load();
        modal.setAttribute('aria-hidden', 'true');
        document.body.style.overflow = '';
        // Return focus
        if (lastFocusedElement) lastFocusedElement.focus();
      }, 400);
    }

    // Play buttons open modal
    const playButtons = document.querySelectorAll('.video-play-btn');
    playButtons.forEach(btn => {
      btn.addEventListener('click', function(e) {
        e.stopPropagation();
        const card = btn.closest('.group');
        const video = card.querySelector('video[data-video]');
        const title = card.querySelector('h3')?.textContent || '';
        const src = video?.querySelector('source')?.src || btn.dataset.videoSrc;
        if (src) openModal(src, title, btn);
      });
    });

    // Click on card (except button) also opens modal
    galleryVideos.forEach(video => {
      const card = video.closest('.group');
      if (card) {
        card.addEventListener('click', function(e) {
          if (e.target.closest('.video-play-btn')) return;
          const title = card.querySelector('h3')?.textContent || '';
          const src = video.querySelector('source')?.src;
          if (src) openModal(src, title, card);
        });
        card.style.cursor = 'pointer';
      }
    });

    // Close handlers
    closeBtn.addEventListener('click', closeModal);
    modal.addEventListener('click', function(e) {
      if (e.target === modal || e.target === modalContent) closeModal();
    });
    document.addEventListener('keydown', function(e) {
      if (e.key === 'Escape' && isOpen) closeModal();
    });

    // Lazy loading gallery videos (only metadata, no play)
    if ('IntersectionObserver' in window) {
      const videoObserver = new IntersectionObserver((entries, observer) => {
        entries.forEach(entry => {
          if (entry.isIntersecting) {
            const video = entry.target;
            if (video.dataset.loaded) return;
            video.dataset.loaded = 'true';
            video.preload = 'metadata';
            observer.unobserve(video);
          }
        });
      }, { rootMargin: '200px', threshold: 0.1 });
      galleryVideos.forEach(video => videoObserver.observe(video));
    }
  });
</script>
