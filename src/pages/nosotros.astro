---
import { getTranslations, type Language } from '../i18n';
import MainLayout from '../layouts/MainLayout.astro';
import Header from '../components/layout/Header.astro';
import Footer from '../components/layout/Footer.astro';

const lang: Language = Astro.locals.lang || 'es';
const t = getTranslations(lang);

const titleWords = t.about.title.split(' ');
const lastWord = titleWords.pop() || '';
const firstPart = titleWords.join(' ');
---

<MainLayout title={`${t.about.title} | Sanvin Shoemakers`}>
  <Header slot="header" />

  <!-- ============================================
       HERO Editorial — About
       ============================================ -->
  <section class="relative bg-[var(--color-bg-secondary)] texture-paper py-24 md:py-32 overflow-hidden">
    <!-- Marca de agua -->
    <div class="absolute inset-0 flex items-center justify-center pointer-events-none overflow-hidden">
      <span class="watermark block leading-none whitespace-nowrap" style="font-size: clamp(10rem, 24vw, 22rem)">Atelier</span>
    </div>

    <div class="relative max-w-5xl mx-auto px-6 text-center">
      <div class="reveal-word" style="animation-delay: 0.1s">
        <span class="kicker">{t.kickers.atelier}</span>
      </div>

      <h1 class="mt-8 font-heading font-medium leading-[0.95] tracking-tight text-[var(--color-text)]" style="font-size: clamp(2.75rem, 7vw, 5.5rem)">
        {firstPart && firstPart.split(' ').map((word, i) => (
          <span class="reveal-word mr-3">
            <span style={`animation-delay: ${0.25 + i * 0.1}s`}>{word}</span>
          </span>
        ))}
        <span class="reveal-word">
          <span class="accent-italic text-[var(--color-accent-deep)]" style={`animation-delay: ${0.25 + (firstPart ? firstPart.split(' ').length : 0) * 0.1}s`}>{lastWord}</span>
        </span>
      </h1>

      <div class="gold-divider mt-10"><span></span></div>

      <p class="mt-10 accent-italic text-lg md:text-xl text-[var(--color-text-secondary)] max-w-2xl mx-auto leading-relaxed">
        {t.about.subtitle}
      </p>
    </div>
  </section>

  <!-- ============================================
       Historia — Video + texto asimétrico
       ============================================ -->
  <section class="relative py-20 md:py-32 bg-[var(--color-bg)] animate-on-scroll overflow-hidden">
    <div class="hidden lg:block absolute top-16 right-12 editorial-num text-[6rem] opacity-30">01</div>

    <div class="max-w-7xl mx-auto px-6 lg:px-12 grid grid-cols-1 md:grid-cols-12 gap-10 lg:gap-16 items-center">
      <!-- Video con detalle dorado -->
      <div class="md:col-span-6 relative">
        <div class="relative">
          <video class="aspect-[4/5] object-cover w-full" autoplay muted loop playsinline src="/0830.mov"></video>
          <!-- Marco dorado decorativo -->
          <div class="absolute -top-3 -left-3 w-24 h-24 border-l border-t border-[var(--color-accent)] pointer-events-none"></div>
          <div class="absolute -bottom-3 -right-3 w-24 h-24 border-r border-b border-[var(--color-accent)] pointer-events-none"></div>
          <!-- Etiqueta -->
          <div class="absolute bottom-4 left-4 z-10">
            <span class="text-[10px] uppercase tracking-[0.3em] text-[var(--color-brand-50)] bg-[var(--color-brand-950)]/60 backdrop-blur-sm px-3 py-1.5">{t.editorial.handmade}</span>
          </div>
        </div>
      </div>

      <!-- Texto -->
      <div class="md:col-span-6 md:pl-8">
        <span class="kicker">{t.kickers.heritage}</span>
        <h2 class="mt-6 text-3xl md:text-5xl font-heading font-medium text-[var(--color-text)] leading-tight">
          {t.about.traditionTitle.split(' ').slice(0, -1).join(' ')} <span class="accent-italic text-[var(--color-accent-deep)]">{t.about.traditionTitle.split(' ').slice(-1)}</span>
        </h2>

        <div class="mt-8 flex items-center gap-3">
          <div class="w-12 h-px bg-[var(--color-accent)]"></div>
          <span class="text-xs uppercase tracking-[0.3em] text-[var(--color-text-secondary)]">{t.editorial.estLabel} {t.editorial.estYear}</span>
        </div>

        <p class="mt-8 text-base md:text-lg text-[var(--color-text)] leading-relaxed dropcap">
          {t.about.traditionText1}
        </p>
        <p class="mt-6 text-base text-[var(--color-text-secondary)] leading-relaxed">
          {t.about.traditionText2}
        </p>
      </div>
    </div>
  </section>

  <!-- ============================================
       Valores — Numeración editorial con iconos custom
       ============================================ -->
  <section class="relative py-20 md:py-32 bg-[var(--color-bg-secondary)] texture-paper animate-on-scroll overflow-hidden">
    <div class="hidden lg:block absolute top-16 left-12 editorial-num text-[6rem] opacity-30">02</div>

    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center mb-20 max-w-2xl mx-auto">
        <span class="kicker">{t.kickers.craft}</span>
        <h2 class="mt-6 text-4xl md:text-5xl font-heading font-medium text-[var(--color-text)] leading-tight"
          set:html={t.about.ourValuesTitle}
        />
        <div class="gold-divider mt-6"><span></span></div>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-3 gap-12 lg:gap-16">
        <!-- Quality -->
        <div class="text-center group">
          <div class="editorial-num text-[4rem] mb-4">01</div>
          <!-- Icono custom: cuero (curva con costura) -->
          <div class="mx-auto w-20 h-20 mb-6 relative flex items-center justify-center">
            <svg xmlns="http://www.w3.org/2000/svg" class="w-16 h-16 text-[var(--color-accent-deep)]" viewBox="0 0 64 64" fill="none" stroke="currentColor" stroke-width="1.2">
              <!-- Trozo de cuero estilizado -->
              <path d="M12 22 C 18 12, 46 12, 52 22 L 52 42 C 46 52, 18 52, 12 42 Z" />
              <!-- Costura interior -->
              <path d="M18 26 C 24 20, 40 20, 46 26 L 46 38 C 40 44, 24 44, 18 38 Z" stroke-dasharray="2 2.5" />
              <!-- Punto central -->
              <circle cx="32" cy="32" r="1.5" fill="currentColor" />
            </svg>
          </div>
          <h3 class="font-heading font-medium text-xl text-[var(--color-text)] mb-3">{t.about.qualityTitle}</h3>
          <div class="w-10 h-px bg-[var(--color-accent)] mx-auto mb-4"></div>
          <p class="text-sm text-[var(--color-text-secondary)] leading-relaxed max-w-xs mx-auto">
            {t.about.qualityText}
          </p>
        </div>

        <!-- Design -->
        <div class="text-center group">
          <div class="editorial-num text-[4rem] mb-4">02</div>
          <!-- Icono custom: aguja con hilo -->
          <div class="mx-auto w-20 h-20 mb-6 relative flex items-center justify-center">
            <svg xmlns="http://www.w3.org/2000/svg" class="w-16 h-16 text-[var(--color-accent-deep)]" viewBox="0 0 64 64" fill="none" stroke="currentColor" stroke-width="1.2">
              <!-- Aguja -->
              <line x1="12" y1="52" x2="50" y2="14" stroke-linecap="round" />
              <!-- Ojo de aguja -->
              <ellipse cx="15" cy="49" rx="3" ry="1.5" transform="rotate(-45 15 49)" />
              <!-- Punta -->
              <path d="M48 12 L 54 18" stroke-linecap="round" />
              <!-- Hilo curvado -->
              <path d="M15 49 C 8 44, 6 36, 10 30 C 14 24, 22 26, 20 32" stroke-dasharray="2 2" />
            </svg>
          </div>
          <h3 class="font-heading font-medium text-xl text-[var(--color-text)] mb-3">{t.about.designTitle}</h3>
          <div class="w-10 h-px bg-[var(--color-accent)] mx-auto mb-4"></div>
          <p class="text-sm text-[var(--color-text-secondary)] leading-relaxed max-w-xs mx-auto">
            {t.about.designText}
          </p>
        </div>

        <!-- Sustainability -->
        <div class="text-center group">
          <div class="editorial-num text-[4rem] mb-4">03</div>
          <!-- Icono custom: horma de zapato -->
          <div class="mx-auto w-20 h-20 mb-6 relative flex items-center justify-center">
            <svg xmlns="http://www.w3.org/2000/svg" class="w-16 h-16 text-[var(--color-accent-deep)]" viewBox="0 0 64 64" fill="none" stroke="currentColor" stroke-width="1.2">
              <!-- Hoja estilizada -->
              <path d="M32 8 C 18 14, 14 32, 22 46 C 26 52, 38 52, 42 46 C 50 32, 46 14, 32 8 Z" />
              <!-- Vena central -->
              <path d="M32 10 L 32 50" />
              <!-- Venas laterales -->
              <path d="M32 22 L 24 28 M 32 22 L 40 28" stroke-linecap="round" />
              <path d="M32 32 L 22 38 M 32 32 L 42 38" stroke-linecap="round" />
            </svg>
          </div>
          <h3 class="font-heading font-medium text-xl text-[var(--color-text)] mb-3">{t.about.sustainTitle}</h3>
          <div class="w-10 h-px bg-[var(--color-accent)] mx-auto mb-4"></div>
          <p class="text-sm text-[var(--color-text-secondary)] leading-relaxed max-w-xs mx-auto">
            {t.about.sustainText}
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- ============================================
       Cita final
       ============================================ -->
  <section class="relative py-24 md:py-32 bg-[var(--color-brand-950)] texture-leather overflow-hidden animate-on-scroll">
    <div class="absolute inset-0 flex items-center justify-center pointer-events-none opacity-[0.04]">
      <span class="font-heading italic text-[18rem] leading-none text-[var(--color-accent)] whitespace-nowrap">"</span>
    </div>

    <div class="relative max-w-3xl mx-auto px-6 text-center">
      <span class="kicker" style="color: var(--color-accent)">{t.editorial.signature}</span>
      <p class="mt-10 accent-italic text-3xl md:text-5xl text-[var(--color-brand-50)] leading-tight">
        {t.about.quoteText}
      </p>
      <div class="gold-divider mt-10"><span></span></div>
      <p class="mt-8 text-xs uppercase tracking-[0.4em] text-[var(--color-brand-100)]/60">— Sanvin Atelier · Madrid</p>
    </div>
  </section>

  <Footer slot="footer" />
</MainLayout>
