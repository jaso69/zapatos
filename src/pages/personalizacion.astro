---
import { getTranslations, type Language } from '../i18n';
import MainLayout from '../layouts/MainLayout.astro';
import Header from '../components/layout/Header.astro';
import Footer from '../components/layout/Footer.astro';
import CustomizeChat from '../components/CustomizeChat.tsx';

const lang: Language = Astro.locals.lang || 'es';
const t = getTranslations(lang);

const titleWords = t.customize.title.split(' ');
const lastWord = titleWords.pop() || '';
const firstPart = titleWords.join(' ');
---

<MainLayout title={`${t.customize.title} | Sanvin Shoemakers`}>
  <Header slot="header" />

  <!-- ============================================
       HERO Editorial — Personalización
       ============================================ -->
  <section class="relative bg-[var(--color-bg-secondary)] texture-paper py-24 md:py-32 overflow-hidden">
    <div class="absolute inset-0 flex items-center justify-center pointer-events-none overflow-hidden">
      <span class="watermark block leading-none whitespace-nowrap" style="font-size: clamp(10rem, 22vw, 20rem)">Bespoke</span>
    </div>

    <div class="relative max-w-5xl mx-auto px-6 text-center">
      <div class="reveal-word" style="animation-delay: 0.1s">
        <span class="kicker">{t.kickers.atelier}</span>
      </div>

      <h1 class="mt-8 font-heading font-medium leading-[0.95] tracking-tight text-[var(--color-text)]" style="font-size: clamp(2.5rem, 7vw, 5.5rem)">
        {firstPart && firstPart.split(' ').map((word, i) => (
          <span class="reveal-word mr-3">
            <span style={`animation-delay: ${0.25 + i * 0.1}s`}>{word}</span>
          </span>
        ))}
        <span class="reveal-word">
          <span class="accent-italic text-[var(--color-accent-deep)]" style={`animation-delay: ${0.25 + (firstPart ? firstPart.split(' ').length : 0) * 0.1}s`}>{lastWord}</span>
        </span>
      </h1>

      <div class="gold-divider mt-10"><span></span></div>

      <p class="mt-10 accent-italic text-lg md:text-xl text-[var(--color-text-secondary)] max-w-2xl mx-auto leading-relaxed">
        {t.customize.subtitle}
      </p>
    </div>
  </section>

  <!-- ============================================
       Proceso — split asimétrico con marco oro
       ============================================ -->
  <section class="relative py-20 md:py-32 bg-[var(--color-bg)] animate-on-scroll overflow-hidden">
    <div class="hidden lg:block absolute top-16 left-12 editorial-num text-[6rem] opacity-30">01</div>

    <div class="max-w-7xl mx-auto px-6 lg:px-12 grid grid-cols-1 md:grid-cols-12 gap-10 lg:gap-16 items-center">
      <!-- Texto -->
      <div class="md:col-span-6 order-2 md:order-1">
        <span class="kicker">{t.kickers.craft}</span>
        <h2 class="mt-6 text-3xl md:text-5xl font-heading font-medium text-[var(--color-text)] leading-tight">
          {t.customize.processTitle.split(' ').slice(0, -1).join(' ')} <span class="accent-italic text-[var(--color-accent-deep)]">{t.customize.processTitle.split(' ').slice(-1)}</span>
        </h2>

        <div class="mt-8 flex items-center gap-3">
          <div class="w-12 h-px bg-[var(--color-accent)]"></div>
          <span class="text-xs uppercase tracking-[0.3em] text-[var(--color-text-secondary)]">Bespoke</span>
        </div>

        <p class="mt-8 text-base md:text-lg text-[var(--color-text)] leading-relaxed dropcap">
          {t.customize.processText1}
        </p>
        <p class="mt-6 text-base text-[var(--color-text-secondary)] leading-relaxed">
          {t.customize.processText2}
        </p>
      </div>

      <!-- Imagen con marco oro -->
      <div class="md:col-span-6 order-1 md:order-2 relative">
        <div class="relative">
          <img src="/amedida.webp" alt="Zapatos personalizados Sanvin" class="w-full aspect-[4/5] object-cover" onerror="this.style.display='none'" />
          <!-- Marco dorado decorativo -->
          <div class="absolute -top-3 -left-3 w-24 h-24 border-l border-t border-[var(--color-accent)] pointer-events-none"></div>
          <div class="absolute -bottom-3 -right-3 w-24 h-24 border-r border-b border-[var(--color-accent)] pointer-events-none"></div>
          <!-- Etiqueta superior -->
          <div class="absolute top-4 right-4 z-10 flex items-center gap-3">
            <div class="w-8 h-px bg-[var(--color-accent)]"></div>
            <span class="text-[10px] uppercase tracking-[0.3em] text-[var(--color-brand-50)] bg-[var(--color-brand-950)]/50 backdrop-blur-sm px-3 py-1.5">{t.editorial.limited}</span>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ============================================
       Opciones — 3 pasos numerados con iconos custom
       ============================================ -->
  <section class="relative py-20 md:py-32 bg-[var(--color-bg-secondary)] texture-paper animate-on-scroll overflow-hidden">
    <div class="hidden lg:block absolute top-16 right-12 editorial-num text-[6rem] opacity-30">02</div>

    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center mb-20 max-w-2xl mx-auto">
        <span class="kicker">{t.kickers.collection}</span>
        <h2 class="mt-6 text-4xl md:text-5xl font-heading font-medium text-[var(--color-text)] leading-tight"
          set:html={t.customize.threePillarsTitle}
        />
        <div class="gold-divider mt-6"><span></span></div>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-3 gap-8 lg:gap-12">
        <!-- Pilar 1 — Ajuste -->
        <div class="relative bg-[var(--color-bg)] border border-[var(--color-accent)]/30 p-10 card-jewel hover:border-[var(--color-accent)] hover:shadow-[0_20px_40px_-15px_rgba(50,24,17,0.15)]">
          <div class="editorial-num text-[4rem] mb-6">01</div>
          <!-- Icono custom: regla/medida -->
          <div class="w-14 h-14 mb-6 flex items-center justify-center">
            <svg xmlns="http://www.w3.org/2000/svg" class="w-12 h-12 text-[var(--color-accent-deep)]" viewBox="0 0 48 48" fill="none" stroke="currentColor" stroke-width="1.2">
              <rect x="6" y="18" width="36" height="12" />
              <line x1="12" y1="18" x2="12" y2="24" />
              <line x1="18" y1="18" x2="18" y2="26" />
              <line x1="24" y1="18" x2="24" y2="24" />
              <line x1="30" y1="18" x2="30" y2="26" />
              <line x1="36" y1="18" x2="36" y2="24" />
            </svg>
          </div>
          <h3 class="font-heading font-medium text-xl text-[var(--color-text)] mb-3">{t.customize.option1Title}</h3>
          <div class="stitched-border h-px mb-4"></div>
          <p class="text-sm text-[var(--color-text-secondary)] leading-relaxed">
            {t.customize.option1Text}
          </p>
        </div>

        <!-- Pilar 2 — Diseño -->
        <div class="relative bg-[var(--color-bg)] border border-[var(--color-accent)]/30 p-10 card-jewel hover:border-[var(--color-accent)] hover:shadow-[0_20px_40px_-15px_rgba(50,24,17,0.15)]">
          <div class="editorial-num text-[4rem] mb-6">02</div>
          <!-- Icono custom: paleta de colores -->
          <div class="w-14 h-14 mb-6 flex items-center justify-center">
            <svg xmlns="http://www.w3.org/2000/svg" class="w-12 h-12 text-[var(--color-accent-deep)]" viewBox="0 0 48 48" fill="none" stroke="currentColor" stroke-width="1.2">
              <path d="M24 6 C 14 6, 6 14, 6 24 C 6 32, 12 38, 20 38 C 22 38, 24 36, 24 34 C 24 32, 22 30, 22 28 C 22 26, 24 24, 26 24 L 36 24 C 40 24, 42 22, 42 18 C 42 12, 34 6, 24 6 Z" />
              <circle cx="14" cy="20" r="2" fill="currentColor" />
              <circle cx="18" cy="14" r="2" fill="currentColor" />
              <circle cx="26" cy="12" r="2" fill="currentColor" />
              <circle cx="34" cy="16" r="2" fill="currentColor" />
            </svg>
          </div>
          <h3 class="font-heading font-medium text-xl text-[var(--color-text)] mb-3">{t.customize.option2Title}</h3>
          <div class="stitched-border h-px mb-4"></div>
          <p class="text-sm text-[var(--color-text-secondary)] leading-relaxed">
            {t.customize.option2Text}
          </p>
        </div>

        <!-- Pilar 3 — Artesanía -->
        <div class="relative bg-[var(--color-bg)] border border-[var(--color-accent)]/30 p-10 card-jewel hover:border-[var(--color-accent)] hover:shadow-[0_20px_40px_-15px_rgba(50,24,17,0.15)]">
          <div class="editorial-num text-[4rem] mb-6">03</div>
          <!-- Icono custom: aguja con hilo -->
          <div class="w-14 h-14 mb-6 flex items-center justify-center">
            <svg xmlns="http://www.w3.org/2000/svg" class="w-12 h-12 text-[var(--color-accent-deep)]" viewBox="0 0 48 48" fill="none" stroke="currentColor" stroke-width="1.2">
              <line x1="8" y1="40" x2="38" y2="10" stroke-linecap="round" />
              <ellipse cx="11" cy="37" rx="2.5" ry="1.2" transform="rotate(-45 11 37)" />
              <path d="M36 8 L 42 14" stroke-linecap="round" />
              <path d="M11 37 C 6 33, 5 26, 9 22 C 13 18, 18 21, 16 26" stroke-dasharray="2 2" />
            </svg>
          </div>
          <h3 class="font-heading font-medium text-xl text-[var(--color-text)] mb-3">{t.customize.option3Title}</h3>
          <div class="stitched-border h-px mb-4"></div>
          <p class="text-sm text-[var(--color-text-secondary)] leading-relaxed">
            {t.customize.option3Text}
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- ============================================
       CTA Chat — atelier oscuro
       ============================================ -->
  <section class="relative py-20 md:py-32 bg-[var(--color-brand-950)] texture-leather overflow-hidden animate-on-scroll">
    <div class="absolute top-16 left-12 editorial-num text-[6rem] opacity-20 hidden lg:block" style="color: var(--color-accent)">03</div>

    <div class="relative max-w-5xl mx-auto px-6">
      <div class="text-center mb-12">
        <span class="kicker" style="color: var(--color-accent)">{t.kickers.join}</span>
        <h2 class="mt-6 text-4xl md:text-5xl font-heading font-medium text-[var(--color-brand-50)] leading-tight">
          {t.customize.ctaTitle.split(' ').slice(0, -1).join(' ')} <span class="accent-italic" style="color: var(--color-accent)">{t.customize.ctaTitle.split(' ').slice(-1)}</span>
        </h2>
        <div class="gold-divider mt-8"><span></span></div>
        <p class="mt-8 accent-italic text-lg text-[var(--color-brand-100)]/80 max-w-xl mx-auto leading-relaxed">
          {t.customize.ctaText}
        </p>
      </div>

      <!-- Chat con marco oro -->
      <div class="relative">
        <div class="absolute -top-3 -left-3 w-12 h-12 border-l border-t border-[var(--color-accent)] pointer-events-none z-10"></div>
        <div class="absolute -bottom-3 -right-3 w-12 h-12 border-r border-b border-[var(--color-accent)] pointer-events-none z-10"></div>
        <div class="bg-[var(--color-bg)]">
          <CustomizeChat client:load t={t.chat.customize} />
        </div>
      </div>
    </div>
  </section>

  <Footer slot="footer" />
</MainLayout>
