---
import { getTranslations, type Language } from '../i18n';
import MainLayout from '../layouts/MainLayout.astro';
import Header from '../components/layout/Header.astro';
import Footer from '../components/layout/Footer.astro';

const lang: Language = Astro.locals.lang || 'es';
const t = getTranslations(lang);

const orderId = Astro.url.searchParams.get('order') || '';
const email = Astro.url.searchParams.get('email') || '';
---

<MainLayout title={`${t.checkout.orderSuccess} | Sanvin Shoemakers`}>
  <Header slot="header" />

  <section class="min-h-[60vh] flex items-center justify-center py-20 bg-[var(--color-bg)]">
    <div class="max-w-lg mx-auto px-6 text-center">
      <!-- Icono éxito -->
      <div class="relative inline-flex items-center justify-center mb-8">
        <div class="absolute inset-0 rounded-full bg-[var(--color-accent)]/20 blur-3xl"></div>
        <div class="relative w-20 h-20 rounded-full bg-[var(--color-accent)]/10 flex items-center justify-center border border-[var(--color-accent)]/30">
          <svg xmlns="http://www.w3.org/2000/svg" class="h-10 w-10 text-[var(--color-accent-deep)]" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
            <path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7" />
          </svg>
        </div>
      </div>

      <span class="kicker">{t.kickers.heritage}</span>

      <h1 class="mt-6 text-3xl md:text-4xl font-heading font-medium text-[var(--color-text)] leading-tight">
        {t.checkout.orderSuccess.split(' ').slice(0, -1).join(' ')} <span class="accent-italic text-[var(--color-accent-deep)]">{t.checkout.orderSuccess.split(' ').slice(-1)}</span>
      </h1>

      <div class="gold-divider mt-6"><span></span></div>

      <p class="mt-6 text-base text-[var(--color-text-secondary)] leading-relaxed">
        {t.checkout.orderSuccessMessage}
      </p>

      {orderId && (
        <div class="mt-8 p-6 bg-[var(--color-surface)] border border-[var(--color-border)] rounded-xl">
          <p class="text-[11px] uppercase tracking-[0.2em] text-[var(--color-text-secondary)]">{t.checkout.orderNumber}</p>
          <p class="mt-2 font-heading text-xl text-[var(--color-accent-deep)]">{orderId}</p>
          {email && (
            <p class="mt-3 text-sm text-[var(--color-text-secondary)]">
              {t.checkout.confirmationSentTo} <span class="text-[var(--color-text)]">{email}</span>
            </p>
          )}
        </div>
      )}

      <div class="mt-10 space-y-4">
        <a href="/tienda" class="btn-fill arrow-slide inline-flex items-center justify-center gap-3 px-9 py-4 bg-[var(--color-brand-700)] text-white font-medium text-xs uppercase tracking-[0.25em] hover:text-white transition-colors duration-300">
          <span>{t.checkout.continueShopping}</span>
          <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
            <path stroke-linecap="round" stroke-linejoin="round" d="M17 8l4 4m0 0l-4 4m4-4H3" />
          </svg>
        </a>
      </div>

      <!-- Heritage tagline -->
      <p class="mt-12 accent-italic text-sm text-[var(--color-text-secondary)]/80">
        — {t.editorial.crafted} · {t.editorial.estLabel} {t.editorial.estYear}
      </p>
    </div>
  </section>

  <Footer slot="footer" />
</MainLayout>
