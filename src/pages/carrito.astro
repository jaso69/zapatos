---
import { getTranslations, type Language } from '../i18n';
import MainLayout from '../layouts/MainLayout.astro';
import Header from '../components/layout/Header.astro';
import Footer from '../components/layout/Footer.astro';

const lang: Language = Astro.locals.lang || 'es';
const t = getTranslations(lang);
---

<MainLayout title={`${t.cart.title} | Sanvin Shoemakers`} noindex={true}>
  <Header slot="header" />

  <!-- Hero pequeño -->
  <section class="relative bg-[var(--color-bg-secondary)] texture-paper py-16 md:py-20 overflow-hidden">
    <div class="absolute inset-0 flex items-center justify-center pointer-events-none overflow-hidden">
      <span class="watermark block leading-none whitespace-nowrap" style="font-size: clamp(8rem, 20vw, 16rem)">{t.cart.title}</span>
    </div>
    <div class="relative max-w-4xl mx-auto px-6 text-center">
      <span class="kicker">{t.kickers.collection}</span>
      <h1 class="mt-6 text-4xl md:text-5xl font-heading font-medium text-[var(--color-text)] leading-tight">
        {t.cart.title.split(' ').slice(0, -1).join(' ')} <span class="accent-italic text-[var(--color-accent-deep)]">{t.cart.title.split(' ').slice(-1)}</span>
      </h1>
      <div class="gold-divider mt-6"><span></span></div>
    </div>
  </section>

  <!-- Contenido del carrito -->
  <section class="py-20 md:py-28 bg-[var(--color-bg)]">
    <div class="max-w-5xl mx-auto px-6">
      <div id="cart-container">
        <!-- Estado vacío (mostrado por defecto, ocultado por JS si hay items) -->
        <div id="cart-empty" class="text-center py-16">
          <div class="relative inline-flex items-center justify-center mb-8">
            <div class="absolute inset-0 rounded-full bg-[var(--color-accent)]/10 blur-2xl"></div>
            <svg xmlns="http://www.w3.org/2000/svg" class="relative h-20 w-20 text-[var(--color-accent-deep)]" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1">
              <path stroke-linecap="round" stroke-linejoin="round" d="M16 11V7a4 4 0 00-8 0v4M5 9h14l1 12H4L5 9z" />
            </svg>
          </div>
          <p class="accent-italic text-2xl md:text-3xl text-[var(--color-text)] leading-tight">
            {t.cart.empty}
          </p>
          <div class="gold-divider mt-8"><span></span></div>
          <p class="mt-8 text-sm text-[var(--color-text-secondary)] max-w-md mx-auto leading-relaxed">
            {t.cart.emptyDescription}
          </p>
          <a href="/tienda" class="btn-fill arrow-slide inline-flex items-center justify-center gap-3 mt-10 px-9 py-4 bg-[var(--color-brand-700)] text-white font-medium text-xs uppercase tracking-[0.25em] hover:text-white transition-colors duration-300">
            <span>{t.cart.explore}</span>
            <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
              <path stroke-linecap="round" stroke-linejoin="round" d="M17 8l4 4m0 0l-4 4m4-4H3" />
            </svg>
          </a>
        </div>

        <!-- Estado con items (oculto por defecto) -->
        <div id="cart-items" class="hidden">
          <div class="space-y-6" id="cart-items-list">
            <!-- Items se renderizan aquí via JS -->
          </div>

          <!-- Resumen -->
          <div class="mt-12 pt-10 border-t border-[var(--color-border)]">
            <div class="max-w-md ml-auto space-y-4">
              <div class="flex items-center justify-between text-sm text-[var(--color-text-secondary)]">
                <span>{t.cart.subtotal}</span>
                <span id="cart-subtotal" class="font-medium text-[var(--color-text)]">—</span>
              </div>
              <div class="flex items-center justify-between text-sm text-[var(--color-text-secondary)]">
                <span>{t.cart.shipping}</span>
                <span class="font-medium text-[var(--color-text)]">{t.cart.freeShipping}</span>
              </div>
              <div class="flex items-center justify-between text-sm text-[var(--color-text-secondary)]">
                <span>{t.cart.taxIncluded}</span>
                <span id="cart-tax" class="font-medium text-[var(--color-text)]">—</span>
              </div>
              <div class="gold-divider my-4"><span></span></div>
              <div class="flex items-center justify-between">
                <span class="text-sm uppercase tracking-[0.2em] text-[var(--color-text)]">{t.cart.total}</span>
                <span id="cart-total" class="font-heading text-3xl text-[var(--color-accent-deep)]">—</span>
              </div>
            </div>

            <div class="mt-10 flex flex-col sm:flex-row gap-4 max-w-md ml-auto">
              <a href="/tienda" class="flex-1 inline-flex items-center justify-center gap-3 min-h-[56px] px-8 py-4 border border-[var(--color-border)] text-[var(--color-text)] font-medium text-xs uppercase tracking-[0.25em] hover:border-[var(--color-accent)] hover:text-[var(--color-accent-deep)] transition-colors duration-300">
                <span>{t.cart.continueShopping}</span>
              </a>
              <a href="/checkout" class="btn-fill arrow-slide flex-1 inline-flex items-center justify-center gap-3 min-h-[56px] px-8 py-4 bg-[var(--color-brand-700)] text-white font-medium text-xs uppercase tracking-[0.25em] hover:text-white transition-colors duration-300">
                <span>{t.cart.checkout}</span>
                <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M14 5l7 7m0 0l-7 7m7-7H3" />
                </svg>
              </a>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <Footer slot="footer" />
</MainLayout>

<script define:vars={{
  tSize: t.cart.size,
  tColor: t.cart.color,
  tUnit: t.cart.unit,
  tRemove: t.cart.remove,
  tDecreaseQty: t.cart.decreaseQty,
  tIncreaseQty: t.cart.increaseQty,
  tToastTitle: t.cart.title,
  tRemoved: t.cart.removed,
}}>
  (function() {
    const MEDUSA_API_URL = 'https://sanvin.rpg-docu.com';
    const MEDUSA_PUBLISHABLE_KEY = 'pk_e7c79206b6937c1be93ad8f7763dfe53f95fd0243de68a6d0f569b07c563b11e';
    const commonHeaders = {
      'x-publishable-api-key': MEDUSA_PUBLISHABLE_KEY,
      'Content-Type': 'application/json',
    };

    function formatPrice(amount, currency) {
      return new Intl.NumberFormat('es-ES', {
        style: 'currency',
        currency: currency || 'EUR',
      }).format(amount);
    }

    function updateCartCount(cart) {
      const countEl = document.getElementById('cart-count');
      if (!countEl || !cart || !cart.items) return;
      const total = cart.items.reduce(function(sum, item) { return sum + item.quantity; }, 0);
      countEl.textContent = total;
      countEl.classList.toggle('hidden', total === 0);
    }

    async function getCart(cartId) {
      try {
        const response = await fetch('/api/cart/get', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ cartId: cartId }),
        });
        if (!response.ok) return null;
        const data = await response.json();
        return data.cart || null;
      } catch (e) { return null; }
    }

    async function updateCartItem(cartId, itemId, quantity) {
      try {
        const response = await fetch('/api/cart/update', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ cartId: cartId, itemId: itemId, quantity: quantity }),
        });
        if (!response.ok) return null;
        const data = await response.json();
        return data.cart || null;
      } catch (e) { return null; }
    }

    async function removeCartItem(cartId, itemId) {
      try {
        const response = await fetch('/api/cart/remove', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ cartId: cartId, itemId: itemId }),
        });
        if (!response.ok) return null;
        const data = await response.json();
        return data.parent || null;
      } catch (e) { return null; }
    }

    function renderCart(cart) {
      const emptyEl = document.getElementById('cart-empty');
      const itemsEl = document.getElementById('cart-items');
      const itemsList = document.getElementById('cart-items-list');
      const subtotalEl = document.getElementById('cart-subtotal');
      const taxEl = document.getElementById('cart-tax');
      const totalEl = document.getElementById('cart-total');

      if (!cart || !cart.items || cart.items.length === 0) {
        if (emptyEl) emptyEl.classList.remove('hidden');
        if (itemsEl) itemsEl.classList.add('hidden');
        return;
      }

      if (emptyEl) emptyEl.classList.add('hidden');
      if (itemsEl) itemsEl.classList.remove('hidden');

      // Render items
      let html = '';
      cart.items.forEach(function(item) {
        const img = item.thumbnail || item.product?.thumbnail || '';
        const title = item.title || item.product?.title || 'Product';
        const subtitle = item.subtitle || item.variant?.title || '';
        const price = item.unit_price || 0;
        const qty = item.quantity || 1;
        const total = price * qty;
        const currency = cart.currency_code || 'EUR';
        const meta = item.metadata || {};
        const metaTalla = meta.talla || meta.size || '';
        const metaColor = meta.color || '';

        html += '<div class="flex gap-4 md:gap-6 p-4 md:p-6 bg-[var(--color-surface)] rounded-xl border border-[var(--color-border)]" data-item-id="' + item.id + '">';
        html += '<div class="w-24 h-24 md:w-32 md:h-32 flex-shrink-0 bg-white rounded-lg overflow-hidden">';
        if (img) {
          html += '<img src="' + img.replace('http://localhost:9000', MEDUSA_API_URL) + '" alt="' + title + '" class="w-full h-full object-contain" />';
        } else {
          html += '<div class="w-full h-full flex items-center justify-center text-[var(--color-accent)]/30"><svg class="h-8 w-8" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1"><path stroke-linecap="round" stroke-linejoin="round" d="M3 17c0-1 1-2 3-2h2c1.5 0 3-1 4-2l3-3c1-1 2-1 3-1h1c1 0 2 1 2 2v3c0 2-1 3-3 3H4c-.5 0-1-.5-1-1zM6 15v2M10 13v2" /></svg></div>';
        }
        html += '</div>';
        html += '<div class="flex-1 min-w-0">';
        html += '<div class="flex items-start justify-between gap-4">';
        html += '<div>';
        html += '<h3 class="text-base font-medium text-[var(--color-text)]">' + title + '</h3>';
        if (metaTalla || metaColor) {
          html += '<p class="mt-1 text-sm text-[var(--color-text-secondary)] accent-italic">';
          if (metaTalla) html += tSize + ': ' + metaTalla;
          if (metaTalla && metaColor) html += ' · ';
          if (metaColor) html += tColor + ': ' + metaColor;
          html += '</p>';
        } else if (subtitle) {
          html += '<p class="mt-1 text-sm text-[var(--color-text-secondary)] accent-italic">' + subtitle + '</p>';
        }
        html += '<p class="mt-2 text-sm text-[var(--color-accent-deep)] font-medium">' + formatPrice(price, currency) + ' <span class="text-[var(--color-text-secondary)] font-normal text-xs">/ ' + tUnit + '</span></p>';
        html += '</div>';
        html += '<button class="remove-btn p-2 text-[var(--color-text-secondary)] hover:text-red-500 transition-colors" aria-label="' + tRemove + '">';
        html += '<svg class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5"><path stroke-linecap="round" stroke-linejoin="round" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16" /></svg>';
        html += '</button>';
        html += '</div>';
        html += '<div class="mt-4 flex items-center gap-4">';
        html += '<div class="flex items-center border border-[var(--color-border)] rounded-lg">';
        html += '<button class="qty-minus px-3 py-2 text-[var(--color-text-secondary)] hover:text-[var(--color-text)] transition-colors" aria-label="' + tDecreaseQty + '">';
        html += '<svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5"><path stroke-linecap="round" stroke-linejoin="round" d="M20 12H4" /></svg>';
        html += '</button>';
        html += '<span class="qty-value w-10 text-center text-sm font-medium text-[var(--color-text)]">' + qty + '</span>';
        html += '<button class="qty-plus px-3 py-2 text-[var(--color-text-secondary)] hover:text-[var(--color-text)] transition-colors" aria-label="' + tIncreaseQty + '">';
        html += '<svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5"><path stroke-linecap="round" stroke-linejoin="round" d="M12 4v16m8-8H4" /></svg>';
        html += '</button>';
        html += '</div>';
        html += '<span class="ml-auto text-lg font-heading text-[var(--color-text)]">' + formatPrice(total, currency) + '</span>';
        html += '</div>';
        html += '</div>';
        html += '</div>';
      });

      if (itemsList) itemsList.innerHTML = html;

      // Update totals
      if (subtotalEl) subtotalEl.textContent = formatPrice(cart.subtotal || 0, cart.currency_code);
      if (taxEl) taxEl.textContent = formatPrice(cart.tax_total || 0, cart.currency_code);
      if (totalEl) totalEl.textContent = formatPrice(cart.total || 0, cart.currency_code);

      // Attach event listeners
      itemsList.querySelectorAll('[data-item-id]').forEach(function(row) {
        const itemId = row.getAttribute('data-item-id');
        const cartId = localStorage.getItem('cart_id');

        const removeBtn = row.querySelector('.remove-btn');
        if (removeBtn) {
          removeBtn.addEventListener('click', async function() {
            const cart = await removeCartItem(cartId, itemId);
            if (cart) {
              updateCartCount(cart);
              renderCart(cart);
              if (window.sanvinToast) {
                window.sanvinToast({ title: tToastTitle, message: tRemoved, duration: 2000 });
              }
            }
          });
        }

        const minusBtn = row.querySelector('.qty-minus');
        const plusBtn = row.querySelector('.qty-plus');
        const qtyEl = row.querySelector('.qty-value');

        if (minusBtn && qtyEl) {
          minusBtn.addEventListener('click', async function() {
            const current = parseInt(qtyEl.textContent, 10);
            if (current > 1) {
              const cart = await updateCartItem(cartId, itemId, current - 1);
              if (cart) {
                updateCartCount(cart);
                renderCart(cart);
              }
            }
          });
        }

        if (plusBtn && qtyEl) {
          plusBtn.addEventListener('click', async function() {
            const current = parseInt(qtyEl.textContent, 10);
            const cart = await updateCartItem(cartId, itemId, current + 1);
            if (cart) {
              updateCartCount(cart);
              renderCart(cart);
            }
          });
        }
      });
    }

    async function loadCart() {
      const cartId = localStorage.getItem('cart_id');
      if (!cartId) {
        renderCart(null);
        return;
      }
      const cart = await getCart(cartId);
      updateCartCount(cart);
      renderCart(cart);
    }

    document.addEventListener('DOMContentLoaded', loadCart);
  })();
</script>
