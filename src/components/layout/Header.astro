---
import { getTranslations, type Language } from '../../i18n';
import LanguageSelector from './LanguageSelector.tsx';

const lang: Language = Astro.locals.lang || 'es';
const t = getTranslations(lang);
const currentPath = Astro.url.pathname;

const navLinks = [
  { href: '/', label: t.nav.home },
  { href: '/personalizacion', label: t.nav.customize },
  { href: '/tienda', label: t.nav.shop },
  { href: '/nosotros', label: t.nav.about },
  { href: '/contacto', label: t.nav.contact },
];
---

<header id="main-header" class="bg-[var(--color-bg)] border-b border-[var(--color-border)] sticky top-0 z-50 transition-all duration-200">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="flex items-center justify-between h-16 md:h-20">
      <!-- Logo -->
      <a href="/" class="flex items-center group" aria-label="Sanvin Shoemakers - Inicio">
        <img src="/logo.webp" alt="Sanvin Shoemakers - Logo de la empresa" class="h-11 md:h-14 w-auto dark:brightness-0 dark:invert transition-[filter,transform] duration-300 group-hover:scale-[1.02]" />
      </a>

      <!-- Navigation desktop -->
      <nav aria-label="Navegación principal" class="hidden md:flex items-center gap-10">
        {navLinks.map(({ href, label }) => (
          <a
            href={href}
            aria-current={currentPath === href ? 'page' : undefined}
            class:list={[
              'nav-underline text-xs font-medium uppercase tracking-[0.25em] transition-colors duration-300',
              currentPath === href
                ? 'is-active text-[var(--color-text)]'
                : 'text-[var(--color-text-secondary)] hover:text-[var(--color-text)]',
            ]}
          >
            {label}
          </a>
        ))}
      </nav>

      <!-- Selector de idioma + Tema + Carrito + Menú móvil -->
      <div class="flex items-center gap-2">
        <LanguageSelector client:load />

        <!-- Botón tema -->
        <button
          id="theme-toggle"
          class="p-2 text-[var(--color-text-secondary)] hover:text-[var(--color-accent-deep)] transition-colors rounded-full hover:bg-[var(--color-surface)]"
          aria-label="Cambiar tema"
        >
          <svg id="icon-sun" xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 hidden" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
            <path stroke-linecap="round" stroke-linejoin="round" d="M12 3v1m0 16v1m9-9h-1M4 12H3m15.364 6.364l-.707-.707M6.343 6.343l-.707-.707m12.728 0l-.707.707M6.343 17.657l-.707.707M16 12a4 4 0 11-8 0 4 4 0 018 0z" />
          </svg>
          <svg id="icon-moon" xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
            <path stroke-linecap="round" stroke-linejoin="round" d="M21 12.79A9 9 0 1111.21 3 7 7 0 0021 12.79z" />
          </svg>
        </button>

        <!-- Botón carrito -->
        <a
          href="/carrito"
          class="relative p-2 text-[var(--color-text-secondary)] hover:text-[var(--color-accent-deep)] transition-colors rounded-full hover:bg-[var(--color-surface)]"
          aria-label="Ver carrito"
        >
          <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
            <path stroke-linecap="round" stroke-linejoin="round" d="M16 11V7a4 4 0 00-8 0v4M5 9h14l1 12H4L5 9z" />
          </svg>
          <span id="cart-count" class="hidden absolute -top-1 -right-1 bg-[var(--color-accent)] text-[var(--color-brand-950)] text-[10px] font-bold rounded-full h-5 w-5 flex items-center justify-center">
            0
          </span>
        </a>

        <!-- Botón menú móvil -->
        <button
          id="mobile-menu-btn"
          class="md:hidden p-2 text-[var(--color-text-secondary)] hover:text-[var(--color-accent-deep)] transition-colors rounded-full hover:bg-[var(--color-surface)]"
          aria-label="Abrir menú"
          aria-expanded="false"
          aria-controls="mobile-menu"
        >
          <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" d="M4 6h16M4 12h16M4 18h16" />
          </svg>
        </button>
      </div>
    </div>
  </div>

  <!-- Menú móvil -->
  <div id="mobile-menu" class="hidden md:hidden border-t border-[var(--color-border)] bg-[var(--color-bg)]">
    <nav aria-label="Menú móvil" class="px-4 py-6 space-y-4">
      {navLinks.map(({ href, label }) => (
        <a
          href={href}
          aria-current={currentPath === href ? 'page' : undefined}
          class:list={[
            'block text-xs font-medium uppercase tracking-[0.25em] py-2 transition-colors duration-300',
            currentPath === href
              ? 'text-[var(--color-accent-deep)]'
              : 'text-[var(--color-text-secondary)] hover:text-[var(--color-text)]',
          ]}
        >
          {label}
        </a>
      ))}
    </nav>
  </div>
</header>

<script>
  const themeToggle = document.getElementById('theme-toggle');
  const iconSun = document.getElementById('icon-sun');
  const iconMoon = document.getElementById('icon-moon');
  const root = document.documentElement;
  const header = document.getElementById('main-header');

  function updateIcons() {
    const isDark = root.classList.contains('dark');
    if (iconSun && iconMoon) {
      iconSun.classList.toggle('hidden', !isDark);
      iconMoon.classList.toggle('hidden', isDark);
    }
  }

  function loadTheme() {
    const stored = localStorage.getItem('theme');
    if (stored === 'dark' || (!stored && window.matchMedia('(prefers-color-scheme: dark)').matches)) {
      root.classList.add('dark');
    } else {
      root.classList.remove('dark');
    }
    updateIcons();
  }

  function toggleTheme() {
    root.classList.toggle('dark');
    localStorage.setItem('theme', root.classList.contains('dark') ? 'dark' : 'light');
    updateIcons();
  }

  function handleScroll() {
    if (header) {
      if (window.scrollY > 50) {
        header.classList.add('bg-[var(--color-bg)]/40', 'backdrop-blur-md', 'shadow-sm');
        header.classList.remove('bg-[var(--color-bg)]');
      } else {
        header.classList.remove('bg-[var(--color-bg)]/50', 'backdrop-blur-md', 'shadow-sm');
        header.classList.add('bg-[var(--color-bg)]');
      }
    }
  }

  loadTheme();
  themeToggle?.addEventListener('click', toggleTheme);
  window.addEventListener('scroll', handleScroll, { passive: true });
  handleScroll();

  const mobileMenuBtn = document.getElementById('mobile-menu-btn');
  const mobileMenu = document.getElementById('mobile-menu');

  function toggleMobileMenu() {
    const isHidden = mobileMenu?.classList.contains('hidden');
    mobileMenu?.classList.toggle('hidden');
    mobileMenuBtn?.setAttribute('aria-expanded', String(!isHidden));
    mobileMenuBtn?.setAttribute('aria-label', isHidden ? 'Cerrar menú' : 'Abrir menú');
  }

  mobileMenuBtn?.addEventListener('click', toggleMobileMenu);

  // Initialize cart count on page load
  (function initCartCount() {
    const cartId = localStorage.getItem('cart_id');
    if (!cartId) return;
    fetch('/api/cart/get', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ cartId: cartId }),
    })
    .then(function(res) { return res.ok ? res.json() : null; })
    .then(function(data) {
      const cart = data?.cart;
      if (!cart || !cart.items) return;
      const total = cart.items.reduce(function(sum, item) { return sum + item.quantity; }, 0);
      const countEl = document.getElementById('cart-count');
      if (countEl) {
        countEl.textContent = total;
        countEl.classList.toggle('hidden', total === 0);
      }
    })
    .catch(function() {});
  })();
</script>